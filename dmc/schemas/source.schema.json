{
  "$id": "dmc:schema:source",
  "version": "1.0.0",
  "title": "Source / Provenance",
  "type": "object",
  "required": ["id", "sourceType", "sourceName", "retrievedAt", "status", "confidence"],
  "properties": {
    "id": { "type": "string", "pattern": "^src-[a-z0-9-]+$" },
    "sourceUrl": { "type": ["string", "null"], "pattern": "^https?://" },
    "sourceType": {
      "type": "string",
      "enum": ["PAGE_WEB", "API", "JSON", "DOCUMENT", "IMAGE", "VIDEO",
               "SOURCE_OFFICIELLE", "EDITORIALE", "TERRITORIALE", "PROJECT_FILE"]
    },
    "sourceName": { "type": "string" },
    "retrievedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "updatedAt": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "externalId": { "type": ["string", "null"] },
    "status": {
      "type": "string",
      "enum": ["PROPOSÉ", "TROUVÉ", "SOURCE_OFFICIELLE", "CONFIRMÉ", "VÉRIFIÉ", "RÉSERVÉ", "À_CONFIRMER"]
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "locator": { "type": ["string", "null"] }
  }
}
