{
  "$id": "dmc:schema:relation",
  "version": "1.0.0",
  "title": "Relation typée du graphe DMC",
  "type": "object",
  "required": ["schemaVersion", "id", "from", "to", "type", "sources", "status", "nature", "confidence", "createdAt"],
  "properties": {
    "schemaVersion": { "type": "string", "enum": ["1.0.0"] },
    "id": { "type": "string", "pattern": "^rel-[a-z0-9-]+$" },
    "from": { "type": "string" },
    "to": { "type": "string" },
    "type": {
      "type": "string",
      "enum": ["SITUE_DANS", "COMMUNE_LIEU", "ILLUSTRE_PAR", "DECRIT_PAR", "MENTIONNE_DANS",
               "PARAIT_DANS", "A_LIEU_PENDANT", "PRODUIT_PAR", "PROPOSE_PAR", "LIE_A",
               "MEME_ENTITE_QUE"]
    },
    "sources": { "type": "array", "items": { "$ref": "dmc:schema:source" } },
    "status": { "type": "string", "enum": ["PROPOSÉ", "TROUVÉ", "SOURCE_OFFICIELLE", "CONFIRMÉ", "VÉRIFIÉ", "RÉSERVÉ", "À_CONFIRMER"] },
    "nature": { "type": "string", "enum": ["RÉEL", "RECONSTITUÉ", "ÉDITORIAL"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "createdAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "updatedAt": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "note": { "type": ["string", "null"] }
  }
}
